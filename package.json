{
  "name": "infini",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "opennextjs-cloudflare build",
    "build:next": "prisma generate && next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "dev": "next dev",
    "test": "vitest run",
    "theme:check": "node scripts/check-light-theme.mjs",
    "repo:check": "node scripts/check-release-state.mjs",
    "release:check": "npm run repo:check && npm test && npm run theme:check && npm run build && npm audit --omit=dev",
    "release:container": "sh scripts/check-container-release.sh",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "user:provision": "node scripts/provision-user.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.14.0",
    "next": "15.5.23",
    "next-auth": "^4.24.11",
    "prisma": "5.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^2.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "4.120.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
