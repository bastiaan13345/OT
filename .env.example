# Infini runtime configuration. Values here are examples only.
DATABASE_URL="file:/data/infini.db"
MEDIA_ROOT="/data/media"
NEXTAUTH_URL="https://infini.example.com"
NEXTAUTH_SECRET="generate-a-random-value-at-least-32-characters-long"
SUPPORT_EMAIL="support@example.com"

